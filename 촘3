        # 이 방식은 복잡한 Nix 표현식보다 훨씬 더 안정적이고 명확합니다.
        install-android-sdk = ''
          yes | ${pkgs.android-sdk-cmdline-tools}/libexec/android-sdk/cmdline-tools/latest/bin/sdkmanager --licenses > /dev/null
          ${pkgs.android-sdk-cmdline-tools}/libexec/android-sdk/cmdline-tools/latest/bin/sdkmanager "platform-tools" "build-tools;34.0.0" "platforms;android-34"
        '';
      };
    };
  };
}
