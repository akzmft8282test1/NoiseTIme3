    # Open VSX Registry에서 설치할 VS Code 확장 프로그램 목록입니다.
    extensions = [
      "dart-code.flutter" # Flutter 개발을 위한 공식 확장 프로그램
    ];
    # 작업 공간 생명주기 훅입니다.
