아래 코드로 .idx/dev.nix 파일의 모든 내용을 교체해주십시오.

{ pkgs, ... }: {
  channel = "stable-25.05";

  packages = [
    pkgs.flutter
    pkgs.firebase-tools
    pkgs.jdk
    pkgs.wget
    pkgs.unzip
  ];

  env = {
    JAVA_HOME = pkgs.jdk.home;
    # [고객님 아이디어 적용] SDK의 위치를 프로젝트 내부로 지정합니다.
    ANDROID_SDK_ROOT = "/home/user/noisetime/android-sdk";
  };

  idx = {
    extensions = [ "dart-code.flutter" ];
    workspace = {
      onCreate = {
        # SDK 설치 및 Gradle 설정 주입
        setup-project-local-sdk = ''
          # 1. 환경 초기화
          rm -rf /home/user/flutter
          rm -f /home/user/.bashrc

          # 2. [고객님 아이디어 적용] SDK를 프로젝트 폴더 내에 설치합니다.
          rm -rf $ANDROID_SDK_ROOT
          wget https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip -O cmd-tools.zip
          mkdir -p $ANDROID_SDK_ROOT
          unzip cmd-tools.zip -d $ANDROID_SDK_ROOT
          rm cmd-tools.zip
          
          export PATH="$ANDROID_SDK_ROOT/cmdline-tools/bin:$PATH"
          yes | sdkmanager --sdk_root=$ANDROID_SDK_ROOT "platforms;android-34" "build-tools;34.0.0" "platform-tools"
          
          # 3. [고객님 아이디어 적용] Gradle 설정 파일에 프로젝트 내부의 SDK 경로를 명시합니다.
          echo "sdk.dir=/home/user/noisetime/android-sdk" > /home/user/noisetime/android/local.properties
          echo "flutter.sdk=${pkgs.flutter.home}" >> /home/user/noisetime/android/local.properties
          echo "flutter.buildMode=release" >> /home/user/noisetime/android/local.properties

          # 4. 터미널 환경 설정
          flutter config --android-sdk $ANDROID_SDK_ROOT
          yes | flutter doctor --android-licenses

          echo '# Android SDK paths (Project-Local)' >> /home/user/.bashrc
          echo 'export ANDROID_SDK_ROOT="/home/user/noisetime/android-sdk"' >> /home/user/.bashrc
          echo 'export PATH="$PATH:$ANDROID_SDK_ROOT/cmdline-tools/bin:$ANDROID_SDK_ROOT/platform-tools"' >> /home/user/.bashrc
        '';
      };

      onStart = {
        source-bashrc = "source /home/user/.bashrc";
        run-doctor = "flutter doctor";
      };
    };
  };
}


