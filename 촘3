        install-and-setup-sdk = ''
          echo "Starting manual Android SDK installation..."
          wget https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip -O cmd-tools.zip
          
          mkdir -p $ANDROID_SDK_ROOT
          unzip cmd-tools.zip -d $ANDROID_SDK_ROOT
          
