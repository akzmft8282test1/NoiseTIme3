    # 이렇게 하면 타입 충돌(conflicting option types) 오류를 근본적으로 해결할 수 있습니다.
    PATH = pkgs.lib.mkAfter ":/home/user/android-sdk/cmdline-tools/bin:/home/user/android-sdk/platform-tools";
