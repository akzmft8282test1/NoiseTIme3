                  navigator.pop();
                } else {
                  // 회원가입 실패 시 미리 저장해둔 scaffoldMessenger를 사용하여 SnackBar 표시
                  scaffoldMessenger.showSnackBar(
                    const SnackBar(content: Text('회원가입에 실패했습니다.')),
                  );
                }
