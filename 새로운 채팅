2. SQL 쿼리 붙여넣기 및 실행

아래의 SQL 코드를 복사하여, 방금 열린 SQL 에디터에 그대로 붙여넣어 주세요. 이 코드는 noise_samples 테이블의 데이터를 기반으로 그룹별 일일 평균 소음, 최대 소음, 소음 발생 횟수를 계산하는 daily_noise_stats라는 이름의 가상 테이블(뷰)을 생성합니다.

CREATE OR REPLACE VIEW daily_noise_stats AS
SELECT
  group_id,
  -- 타임스탬프에서 날짜 부분만 추출합니다.
  DATE(created_at) AS report_day,
  -- 소음 레벨의 평균을 계산합니다.
  AVG(db_level) AS avg_db,
  -- 소음 레벨의 최댓값을 계산합니다.
  MAX(db_level) AS max_db,
  -- 소음 발생 횟수를 셉니다.
  COUNT(id) AS event_count
FROM
  public.noise_samples
GROUP BY
  -- 그룹 ID와 날짜로 그룹화합니다.
  group_id,
  DATE(created_at)
ORDER BY
  -- 날짜순으로 정렬합니다.
  report_day;


